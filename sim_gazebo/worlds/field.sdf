<?xml version="1.0"?>
<!-- 자동 생성: sim_gazebo/scripts/make_world.py
     측량값 출처 = farm_robot/config.py (두 시뮬이 어긋나지 않게 단일 출처)
       고랑 간격 1.0m / 고랑 반폭 0.2m / 이랑 높이 0.15m
       팻말 10cm, 오프셋 0.3m, 기울기 30.0도 -->
<sdf version="1.10">
  <world name="field">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <!-- [중요] 조명이 약하면 마커의 '흰 셀'이 어두운 회색으로 렌더돼
         ArUco 가 요구하는 흑백 대비가 나오지 않는다(실제로 검출 0건이었다).
         환경광을 충분히 주고, 팻말 면(-y 방향)을 비추는 보조광을 둔다. -->
    <scene>
      <ambient>0.75 0.75 0.75 1</ambient>
      <background>0.75 0.80 0.88 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.3 0.4 -0.9</direction>
    </light>
    <!-- 팻말 정면(-y)을 비추는 보조광: 마커 대비 확보용 -->
    <light type="directional" name="fill_front">
      <cast_shadows>false</cast_shadows>
      <pose>0 -20 8 0 0 0</pose>
      <diffuse>0.6 0.6 0.6 1</diffuse>
      <direction>0 1 -0.35</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="l">
        <collision name="c"><geometry><plane><normal>0 0 1</normal>
          <size>200 200</size></plane></geometry></collision>
        <visual name="v"><geometry><plane><normal>0 0 1</normal>
          <size>200 200</size></plane></geometry>
          <material><ambient>0.4 0.32 0.24 1</ambient><diffuse>0.5 0.4 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="ridges">
      <static>true</static>
      <link name="ridge_-1">
        <pose>-1.5 0 0 0 0 0</pose>
        <collision name="c">
          <geometry><mesh><uri>/sim/models/ridge/ridge.obj</uri></mesh></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><mesh><uri>/sim/models/ridge/ridge.obj</uri></mesh></geometry>
        </visual>
      </link>
      <link name="ridge_0">
        <pose>-0.5 0 0 0 0 0</pose>
        <collision name="c">
          <geometry><mesh><uri>/sim/models/ridge/ridge.obj</uri></mesh></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><mesh><uri>/sim/models/ridge/ridge.obj</uri></mesh></geometry>
        </visual>
      </link>
      <link name="ridge_1">
        <pose>0.5 0 0 0 0 0</pose>
        <collision name="c">
          <geometry><mesh><uri>/sim/models/ridge/ridge.obj</uri></mesh></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><mesh><uri>/sim/models/ridge/ridge.obj</uri></mesh></geometry>
        </visual>
      </link>
      <link name="ridge_2">
        <pose>1.5 0 0 0 0 0</pose>
        <collision name="c">
          <geometry><mesh><uri>/sim/models/ridge/ridge.obj</uri></mesh></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><mesh><uri>/sim/models/ridge/ridge.obj</uri></mesh></geometry>
        </visual>
      </link>
      <link name="ridge_3">
        <pose>2.5 0 0 0 0 0</pose>
        <collision name="c">
          <geometry><mesh><uri>/sim/models/ridge/ridge.obj</uri></mesh></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><mesh><uri>/sim/models/ridge/ridge.obj</uri></mesh></geometry>
        </visual>
      </link>
      <link name="ridge_4">
        <pose>3.5 0 0 0 0 0</pose>
        <collision name="c">
          <geometry><mesh><uri>/sim/models/ridge/ridge.obj</uri></mesh></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><mesh><uri>/sim/models/ridge/ridge.obj</uri></mesh></geometry>
        </visual>
      </link>
    </model>

    <model name="post_0">
      <static>true</static>
      <link name="pole">
        <pose>-0.500 0.000 0.200 0 0 0</pose>
        <collision name="c"><geometry><cylinder><radius>0.015</radius>
          <length>0.400</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.015</radius>
          <length>0.400</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient>
            <diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
      </link>
      <link name="plate">
        <pose>-0.500 0.000 0.450 0 0 -1.0472</pose>
        <collision name="c"><geometry><box><size>0.100 0.008 0.100</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.100 0.008 0.100</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0 0 0 1</specular>
            <pbr><metal>
              <albedo_map>/sim/models/markers/aruco_0.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>1.0</roughness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>
    <model name="post_1">
      <static>true</static>
      <link name="pole">
        <pose>0.500 0.000 0.200 0 0 0</pose>
        <collision name="c"><geometry><cylinder><radius>0.015</radius>
          <length>0.400</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.015</radius>
          <length>0.400</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient>
            <diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
      </link>
      <link name="plate">
        <pose>0.500 0.000 0.450 0 0 -1.0472</pose>
        <collision name="c"><geometry><box><size>0.100 0.008 0.100</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.100 0.008 0.100</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0 0 0 1</specular>
            <pbr><metal>
              <albedo_map>/sim/models/markers/aruco_1.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>1.0</roughness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>
    <model name="post_2">
      <static>true</static>
      <link name="pole">
        <pose>1.500 0.000 0.200 0 0 0</pose>
        <collision name="c"><geometry><cylinder><radius>0.015</radius>
          <length>0.400</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.015</radius>
          <length>0.400</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient>
            <diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
      </link>
      <link name="plate">
        <pose>1.500 0.000 0.450 0 0 -1.0472</pose>
        <collision name="c"><geometry><box><size>0.100 0.008 0.100</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.100 0.008 0.100</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0 0 0 1</specular>
            <pbr><metal>
              <albedo_map>/sim/models/markers/aruco_2.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>1.0</roughness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>
    <model name="post_3">
      <static>true</static>
      <link name="pole">
        <pose>2.500 0.000 0.200 0 0 0</pose>
        <collision name="c"><geometry><cylinder><radius>0.015</radius>
          <length>0.400</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.015</radius>
          <length>0.400</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient>
            <diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
      </link>
      <link name="plate">
        <pose>2.500 0.000 0.450 0 0 -1.0472</pose>
        <collision name="c"><geometry><box><size>0.100 0.008 0.100</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.100 0.008 0.100</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0 0 0 1</specular>
            <pbr><metal>
              <albedo_map>/sim/models/markers/aruco_3.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>1.0</roughness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>
    <model name="post_4">
      <static>true</static>
      <link name="pole">
        <pose>3.500 0.000 0.200 0 0 0</pose>
        <collision name="c"><geometry><cylinder><radius>0.015</radius>
          <length>0.400</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.015</radius>
          <length>0.400</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient>
            <diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
      </link>
      <link name="plate">
        <pose>3.500 0.000 0.450 0 0 -1.0472</pose>
        <collision name="c"><geometry><box><size>0.100 0.008 0.100</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.100 0.008 0.100</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0 0 0 1</specular>
            <pbr><metal>
              <albedo_map>/sim/models/markers/aruco_4.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>1.0</roughness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>
    <model name="post_249">
      <static>true</static>
      <link name="pole">
        <pose>3.500 0.000 0.200 0 0 0</pose>
        <collision name="c"><geometry><cylinder><radius>0.015</radius>
          <length>0.400</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.015</radius>
          <length>0.400</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient>
            <diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
      </link>
      <link name="plate">
        <pose>3.500 0.000 0.450 0 0 -1.0472</pose>
        <collision name="c"><geometry><box><size>0.100 0.008 0.100</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.100 0.008 0.100</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0 0 0 1</specular>
            <pbr><metal>
              <albedo_map>/sim/models/markers/aruco_249.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>1.0</roughness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- AGV: 첫 이랑보다 왼쪽 헤드랜드에서 밭 안쪽(+y)을 바라보고 출발 -->
    <include>
      <uri>/sim/models/agv</uri>
      <name>agv</name>
      <pose>0.0 0.4 0 0 0 1.5708</pose>
    </include>
  </world>
</sdf>
