<?xml version="1.0"?>
<!-- 자동 생성: sim_gazebo/scripts/make_robot.py
     전체 30x18x50cm (폭 18cm 실기값)
     헐 18cm + 마스트 30cm, 카메라 45cm
     ※ 탱크 궤도는 차동구동 근사. 회전 미끄러짐 수치는 신뢰하지 말 것. -->
<sdf version="1.10">
  <model name="agv">
    <link name="base_link">
      <pose>0 0 0.1100 0 0 0</pose>
      <inertial>
        <pose>0 0 -0.02 0 0 0</pose>
        <mass>8.0</mass>
        <inertia><ixx>0.0432</ixx><iyy>0.0816</iyy><izz>0.0816</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="col_hull">
        <pose>0.000 0.000 0.000 0 0 0</pose>
        <geometry><box><size>0.300 0.180 0.180</size></box></geometry>
      </collision>
      <visual name="vis_hull">
        <pose>0.000 0.000 0.000 0 0 0</pose>
        <geometry><box><size>0.300 0.180 0.180</size></box></geometry>
        <material><ambient>0.20 0.35 0.50 1</ambient><diffuse>0.20 0.35 0.50 1</diffuse></material>
      </visual>
      <visual name="vis_track_l">
        <pose>0.000 0.105 -0.070 0 0 0</pose>
        <geometry><box><size>0.300 0.030 0.080</size></box></geometry>
        <material><ambient>0.10 0.10 0.12 1</ambient><diffuse>0.10 0.10 0.12 1</diffuse></material>
      </visual>
      <visual name="vis_track_r">
        <pose>0.000 -0.105 -0.070 0 0 0</pose>
        <geometry><box><size>0.300 0.030 0.080</size></box></geometry>
        <material><ambient>0.10 0.10 0.12 1</ambient><diffuse>0.10 0.10 0.12 1</diffuse></material>
      </visual>
      <collision name="col_mast">
        <pose>0.000 0.000 0.240 0 0 0</pose>
        <geometry><box><size>0.080 0.080 0.300</size></box></geometry>
      </collision>
      <visual name="vis_mast">
        <pose>0.000 0.000 0.240 0 0 0</pose>
        <geometry><box><size>0.080 0.080 0.300</size></box></geometry>
        <material><ambient>0.30 0.30 0.34 1</ambient><diffuse>0.30 0.30 0.34 1</diffuse></material>
      </visual>
      <collision name="col_caster_f">
        <pose>0.120 0 -0.0840 0 0 0</pose>
        <geometry><sphere><radius>0.020</radius></sphere></geometry>
        <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction>
          <bounce><restitution_coefficient>0</restitution_coefficient></bounce></surface>
      </collision>
      <collision name="col_caster_r">
        <pose>-0.120 0 -0.0840 0 0 0</pose>
        <geometry><sphere><radius>0.020</radius></sphere></geometry>
        <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction>
          <bounce><restitution_coefficient>0</restitution_coefficient></bounce></surface>
      </collision>

      <sensor name="front_camera" type="camera">
        <pose>0.150 0 0.340 0 0 0</pose>
        <update_rate>20</update_rate><topic>camera</topic>
        <camera>
          <horizontal_fov>1.08210</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>50</far></clip>
          <distortion><k1>0</k1><k2>0</k2><k3>0</k3><p1>0</p1><p2>0</p2></distortion>
        </camera>
        <always_on>1</always_on>
      </sensor>

      <sensor name="tof_left" type="gpu_lidar">
        <pose>0 0.120 -0.030 0 0 1.5708</pose>
        <update_rate>20</update_rate><topic>tof_left</topic>
        <lidar>
          <scan><horizontal><samples>1</samples>
            <min_angle>0</min_angle><max_angle>0</max_angle></horizontal></scan>
          <range><min>0.02</min><max>0.80</max>
            <resolution>0.001</resolution></range>
        </lidar>
        <always_on>1</always_on>
      </sensor>

      <sensor name="tof_right" type="gpu_lidar">
        <pose>0 -0.120 -0.030 0 0 -1.5708</pose>
        <update_rate>20</update_rate><topic>tof_right</topic>
        <lidar>
          <scan><horizontal><samples>1</samples>
            <min_angle>0</min_angle><max_angle>0</max_angle></horizontal></scan>
          <range><min>0.02</min><max>0.80</max>
            <resolution>0.001</resolution></range>
        </lidar>
        <always_on>1</always_on>
      </sensor>
    </link>

    <link name="wheel_left">
      <pose>0 0.0850 0.0330 0 0 0</pose>
      <inertial><mass>0.4</mass>
        <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c">
        <geometry><sphere><radius>0.0330</radius></sphere></geometry>
        <surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2>
          <slip1>0.0</slip1><slip2>0.0</slip2></ode></friction>
          <contact><ode><kp>1e6</kp><kd>100</kd></ode></contact></surface>
      </collision>
      <visual name="v">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.0330</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>
    <joint name="wheel_left_joint" type="revolute">
      <parent>base_link</parent><child>wheel_left</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <link name="wheel_right">
      <pose>0 -0.0850 0.0330 0 0 0</pose>
      <inertial><mass>0.4</mass>
        <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c">
        <geometry><sphere><radius>0.0330</radius></sphere></geometry>
        <surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2>
          <slip1>0.0</slip1><slip2>0.0</slip2></ode></friction>
          <contact><ode><kp>1e6</kp><kd>100</kd></ode></contact></surface>
      </collision>
      <visual name="v">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.0330</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>
    <joint name="wheel_right_joint" type="revolute">
      <parent>base_link</parent><child>wheel_right</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.17</wheel_separation>
      <wheel_radius>0.033</wheel_radius>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id>
    </plugin>
  </model>
</sdf>
